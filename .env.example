# ==============================================================================
# Hauntings of the Rift - Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Application & Hosting
# ------------------------------------------------------------------------------
APP_URL=https://hauntings-of-the-rift.vercel.app
SITE_URL=https://hauntings-of-the-rift.vercel.app
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Google Cloud SQL / PostgreSQL (Drizzle ORM & Connection Pooling)
# ------------------------------------------------------------------------------
# Cloud SQL Runtime (App User - Object Method)
SQL_HOST=
SQL_PORT=5432
SQL_DB_NAME=hauntings_rift
SQL_USER=rift_app_user
SQL_PASSWORD=
SQL_SSL=true

# Cloud SQL Schema Migrations (Admin User for drizzle-kit)
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=

# Standard PostgreSQL Connection String (Vercel Postgres / Neon / Direct TCP)
DATABASE_URL=
POSTGRES_URL=

# ------------------------------------------------------------------------------
# 3. Firebase & Google Workspace (Vercel Deployment Variables)
# ------------------------------------------------------------------------------
# Automatically read from firebase-applet-config.json, with Vercel env overrides:
FIREBASE_PROJECT_ID=verve-509008
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=verve-509008.firebaseapp.com
FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-riftsembrace-48b92d68-fb99-42e2-b7e5-f301859f199f
FIREBASE_STORAGE_BUCKET=verve-509008.firebasestorage.app
FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=verve-509008
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=verve-509008.firebaseapp.com
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-riftsembrace-48b92d68-fb99-42e2-b7e5-f301859f199f
VITE_FIREBASE_STORAGE_BUCKET=verve-509008.firebasestorage.app
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 4. M-Pesa Daraja Payment Gateway
# ------------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_URL=https://hauntings-of-the-rift.vercel.app/api/mpesa/callback

# ------------------------------------------------------------------------------
# 5. Email Communications (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=tickets@verve.co.ke
RECOVERY_FROM_EMAIL=tickets@verve.co.ke

# ------------------------------------------------------------------------------
# 6. WhatsApp Notifications (Meta Cloud API / Twilio)
# ------------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_KEY=
TWILIO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 7. Cryptographic & Admission Tokens
# ------------------------------------------------------------------------------
TICKET_HMAC_SECRET=
RECOVERY_LINK_SECRET=

# ------------------------------------------------------------------------------
# 8. Supabase (Optional Resilient Mirror / Fallback)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
